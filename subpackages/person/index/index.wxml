<!--subpackages/person/index/index.wxml-->
<view class="container">
  <view class="user-card">
    <view class="avatar-section">
      <view class="avatar-placeholder">
        <text>{{userInfo.name[0] || userInfo.username[0] || 'U'}}</text>
      </view>
      <view class="user-name">{{userInfo.name || '未设置姓名'}}</view>
      <view class="user-role">{{userInfo.role || '未设置角色'}}</view>
    </view>
  </view>

  <view class="info-list">
    <view class="info-item">
      <text class="label">用户名</text>
      <text class="value">{{userInfo.username || '未设置'}}</text>
    </view>
    <view class="info-item">
      <text class="label">手机号</text>
      <text class="value">{{userInfo.phone || '未设置'}}</text>
    </view>
    <view class="info-item">
      <text class="label">性别</text>
      <text class="value">{{userInfo.sex === 1 ? '女':'男' || '未设置'}}</text>
    </view>
    <view class="info-item">
      <text class="label">身份证号</text>
      <text class="value">{{userInfo.idNumber || '未设置'}}</text>
    </view>
    <view class="info-item">
      <text class="label">公司ID</text>
      <text class="value">{{userInfo.companyId || '未设置'}}</text>
    </view>
    <view class="info-item">
      <text class="label">账号状态</text>
      <text class="value">{{userInfo.status === 1 ? '正常' : '禁用'}}</text>
    </view>
  </view>

  <view class="btn-section">
    <button class="edit-btn" bindtap="editProfile">编辑个人信息</button>
  </view>

  <view class="btn-section">
    <button class="change-btn" bindtap="changePassword">修改密码</button>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <view class="loading-spinner"></view>
    <text>加载中...</text>
  </view>
</view>