<view class="container">
  <view wx:if="{{loading}}" class="loading-container">
    <view class="loading">加载中...</view>
  </view>
  <view wx:else class="form-group">
    <view class="form-item">
      <text class="label">用户名</text>
      <input class="input {{!isEditing.username ? 'placeholder' : ''}}" type="text" placeholder="请输入用户名" value="{{username}}" bindinput="onUsernameInput"/>
    </view>
    <view class="form-item">
      <text class="label">姓名</text>
      <input class="input {{!isEditing.name ? 'placeholder' : ''}}" type="text" placeholder="请输入姓名" value="{{name}}" bindinput="onNameInput"/>
    </view>
    <view class="form-item">
      <text class="label">手机号</text>
      <input class="input {{!isEditing.phone ? 'placeholder' : ''}}" type="number" placeholder="请输入手机号" value="{{phone}}" bindinput="onPhoneInput"/>
    </view>
    <view class="form-item">
      <text class="label">性别</text>
      <picker bindchange="onSexChange" value="{{sexIndex}}" range="{{sexArray}}">
        <view class="picker {{!isEditing.sex ? 'placeholder' : ''}}">
          {{sexArray[sexIndex]}}
        </view>
      </picker>
    </view>
    <view class="form-item">
      <text class="label">身份证号</text>
      <input class="input {{!isEditing.idNumber ? 'placeholder' : ''}}" type="idcard" placeholder="请输入身份证号" value="{{idNumber}}" bindinput="onIdNumberInput"/>
    </view>
  </view>
  <view class="button-group">
    <button class="submit-btn" type="primary" bindtap="submitForm">保存</button>
  </view>
</view> 