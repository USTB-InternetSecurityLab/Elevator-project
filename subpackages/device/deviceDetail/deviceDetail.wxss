.container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 加载状态 */
.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #1890ff;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  color: #999;
  font-size: 28rpx;
}

/* 设备基本信息 */
.device-info {
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.device-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.device-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.device-status {
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-normal {
  background: rgba(24, 144, 255, 0.1);
  color: #1890ff;
}

.status-warning {
  background: rgba(245, 34, 45, 0.1);
  color: #f5222d;
}

.device-time {
  font-size: 24rpx;
  color: #999;
}

/* 区块链数据 */
.blockchain-section {
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.blockchain-card {
  background: #f9f9f9;
  padding: 20rpx;
  border-radius: 8rpx;
}

.blockchain-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #eee;
}

.blockchain-row:last-child {
  margin-bottom: 0;
  border-bottom: none;
}

.blockchain-row .label {
  color: #666;
  font-size: 28rpx;
  width: 180rpx;
  flex-shrink: 0;
}

.blockchain-row .value {
  color: #333;
  font-size: 28rpx;
  flex: 1;
  word-break: break-all;
}

/* 图表区域 */
.chart-section {
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.chart-wrapper {
  width: 100%;
  height: 400rpx;
  position: relative;
}

ec-canvas {
  width: 100% !important;
  height: 100% !important;
  display: block;
}

/* 电梯列表 */
.elevator-section {
  background: #fff;
  padding: 30rpx;
  border-radius: 12rpx;
}

.elevator-list {
  margin-top: 20rpx;
}

.elevator-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.elevator-item:last-child {
  border-bottom: none;
}

.elevator-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.elevator-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.elevator-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.elevator-status {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  display: inline-block;
}

.arrow-right {
  width: 12rpx;
  height: 12rpx;
  border-top: 4rpx solid #999;
  border-right: 4rpx solid #999;
  transform: rotate(45deg);
  margin-left: 20rpx;
}