/* pages/elevatorMap/elevatorMap.wxss */
.container {
  position: relative;
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.map {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
  z-index: 1;
}

/* 加载状态 */
.loading {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.loading-spinner {
  width: 40rpx;
  height: 40rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #3498db;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

.loading-text {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #666;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 信息面板 */
.info-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #fff;
  border-radius: 30rpx 30rpx 0 0;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  z-index: 2;
  height: 40vh;
  transition: height 0.3s ease;
}

.info-panel.expanded {
  height: 60vh;
}

.panel-handle {
  width: 60rpx;
  height: 6rpx;
  background: #ddd;
  border-radius: 3rpx;
  margin: 20rpx auto;
}

.panel-content {
  height: calc(100% - 46rpx);
  overflow-y: auto;
  padding: 30rpx 30rpx 30rpx 30rpx;
  box-sizing: border-box;
  margin-top: 30rpx;
}

/* 电梯头部信息 */
.elevator-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.elevator-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.elevator-status {
  padding: 10rpx 20rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.status-normal {
  background: #e8f5e9;
  color: #2e7d32;
}

.status-warning {
  background: #fff3e0;
  color: #f57c00;
}

.status-error {
  background: #ffebee;
  color: #c62828;
}

/* 电梯图片 */
.elevator-image-container {
  width: 100%;
  height: 300rpx;
  margin: 20rpx 0;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.elevator-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* 信息分组 */
.info-section {
  margin-top: 30rpx;
}

.info-group {
  margin-bottom: 30rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 20rpx;
}

.info-item {
  display: flex;
  margin-bottom: 20rpx;
  padding: 10rpx 0;
}

.info-item:last-child {
  margin-bottom: 0;
}

.label {
  width: 180rpx;
  color: #666;
  font-size: 28rpx;
  font-weight: 500;
}

.value {
  flex: 1;
  color: #333;
  font-size: 28rpx;
  line-height: 1.5;
}