/* pages/deviceList/deviceList.wxss */
.container {
  padding: 20rpx;
  min-height: 100vh;
  background-color: #f5f5f5;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 200rpx;
}

.loading-text {
  color: #999;
  font-size: 28rpx;
}

.device-list {
  margin-bottom: 30rpx;
}

.empty-state {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 28rpx;
}

.device-items {
  background-color: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.device-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #eee;
}

.device-item:last-child {
  border-bottom: none;
}

.device-info {
  flex: 1;
}

.device-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.device-model {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.device-status {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
  font-size: 24rpx;
}

.status-online {
  background-color: #e6f7ff;
  color: #1890ff;
}

.status-offline {
  background-color: #f5f5f5;
  color: #999;
}

.device-arrow {
  color: #999;
}

.pagination {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 30rpx;
  padding: 20rpx;
  background-color: #fff;
  border-radius: 12rpx;
}

.page-btn {
  padding: 10rpx 30rpx;
  background-color: #1890ff;
  color: #fff;
  border-radius: 6rpx;
  font-size: 28rpx;
}

.page-btn.disabled {
  background-color: #ccc;
  pointer-events: none;
}

.page-info {
  color: #666;
  font-size: 28rpx;
}

/* 加载状态样式 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 200rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f3f3f3;
  border-top: 4rpx solid #3498db;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

/* 设备列表样式 */
.device-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.device-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.device-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.device-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
}

.device-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.status-normal {
  background: rgba(103, 194, 58, 0.1);
  color: #67C23A;
}

.status-warning {
  background: rgba(230, 67, 64, 0.1);
  color: #E64340;
}

.device-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-item {
  display: flex;
  align-items: center;
}

.label {
  font-size: 28rpx;
  color: #666666;
  margin-right: 10rpx;
}

.value {
  font-size: 28rpx;
  color: #333333;
}

/* 头部背景 */
.header-bg {
  background-image: linear-gradient(135deg, #6B73FF 0%, #c8fcbd 100%);
  width: 100%;
  height: 300rpx;
  position: absolute;
  top: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  padding-bottom: 40rpx;
}

.header-content {
  width: 100%;
  padding: 0 40rpx;
  margin-top: -10rpx; /* 微调负边距 */
  transform: translateY(-20rpx); /* 二次位移 */
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 6rpx;
}

.header-subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 搜索栏 */
.search-container {
  position: relative;
  padding: 30rpx;
  z-index: 1;
}

.search-box {
  position: relative;
  background: #fff;
  border-radius: 40rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
}

.search-input {
  flex: 1;
  height: 80rpx;
  font-size: 28rpx;
}

.placeholder-style {
  color: #999;
}

/* 列表容器 */
.list-container {
  position: relative;
  background: #fff;
  margin-top: 180rpx;
  border-radius: 30rpx 30rpx 0 0;
  padding: 40rpx 30rpx;
  box-shadow: 0 -10rpx 30rpx rgba(0,0,0,0.08);
  z-index: 2;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.device-count {
  font-size: 24rpx;
  color: #999;
}

/* 设备列表 */
.device-item {
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  transition: all 0.3s;
}

.device-item:active {
  transform: scale(0.98);
  opacity: 0.9;
}

.device-content {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.device-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  margin-right: 30rpx;
  background: #f0f0f0;
}

.device-arrow {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.arrow-icon {
  width: 12rpx;
  height: 12rpx;
  border-top: 4rpx solid #999;
  border-right: 4rpx solid #999;
  transform: rotate(45deg);
}

/* 底部安全区域 */
.list-container {
  padding-bottom: 100rpx; /* 防止导航栏遮挡 */
}