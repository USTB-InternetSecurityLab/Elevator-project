page {
  background: linear-gradient(135deg, #aab8f1 0%, #96c596 100%);
}

.page-container {
  height: 100vh;
  padding-bottom: 40rpx;
}

/* 渐变 Banner */
.banner {
  height: 320rpx;
  background: linear-gradient(135deg, #6B73FF 0%, #bdfcbd 100%);
  margin: 0rpx;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  padding: 20rpx;
  box-shadow: 0 20rpx 40rpx rgba(0,0,0,0.15);
  transition: all 0.3s ease;
}

.banner-content {
  text-align: center;
  animation: fadeIn 0.8s ease-out;
}

.banner-title {
  font-size: 44rpx;
  font-weight: bold;
  text-align: center;
  display: block;
  margin-bottom: 15rpx;
  text-shadow: 2rpx 2rpx 4rpx rgba(0,0,0,0.1);
}

.banner-subtitle {
  font-size: 32rpx;
  text-align: center;
  display: block;
  margin-top: 15rpx;
  opacity: 0.9;
}

.banner-desc {
  font-size: 26rpx;
  opacity: 0.8;
  margin-top: 20rpx;
  display: block;
}

/* 轮播图 */
.swiper-container {
  margin: 30rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 15rpx 30rpx rgba(0,0,0,0.1);
}

.swiper-image {
  width: 100%;
  height: 400rpx;
  transition: transform 0.3s ease;
}

/* 产品海报样式 */
.product-poster-container {
  position: relative;
  margin: 30rpx;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.12);
}

.product-poster {
  width: 100%;
  display: block;
  transition: transform 0.4s cubic-bezier(0.18, 0.89, 0.32, 1.28);
}

.poster-hover {
  transform: scale(1.02);
}

/* 浮动标签 */
.poster-label {
  position: absolute;
  bottom: 40rpx;
  left: 40rpx;
  right: 40rpx;
  background: linear-gradient(to right, rgba(103, 103, 107, 0.9), rgba(205, 250, 168, 0.7));
  padding: 30rpx;
  border-radius: 16rpx;
  color: white;
  backdrop-filter: blur(10rpx);
  animation: slideUp 0.6s ease-out;
}

.label-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  margin-bottom: 15rpx;
}

.label-desc {
  display: block;
  font-size: 28rpx;
  line-height: 1.6;
  opacity: 0.9;
}

/* 公司信息 */
.company-info-container {
  margin: 30rpx;
  border-radius: 20rpx;
  overflow: hidden;
}

.company-info {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  padding: 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 8rpx 30rpx rgba(0,0,0,0.08);
}

.info-left {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.info-item {
  display: flex;
  align-items: center;
  margin: 20rpx 0;
  transition: transform 0.3s ease;
}

.info-item:hover {
  transform: translateX(10rpx);
}

.info-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.info-text {
  font-size: 28rpx;
  color: #333;
}

.poster-code {
  width: 100%;
  height: 400rpx;
  object-fit: cover;
  display: block;
  margin-bottom: 0rpx;
  border-radius: 0rpx;
}

/* 动画关键帧 */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(-20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes slideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}