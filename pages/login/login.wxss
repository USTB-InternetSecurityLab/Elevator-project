/* 背景渐变效果 */
.login-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  background: linear-gradient(135deg, #8aa6ee, #b4f5a1);
  padding: 20rpx;
}

/* 登录框的样式 */
.login-box {
  width: 100%;
  max-width: 500rpx;
  padding: 50rpx;
  background: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
  text-align: center;
  opacity: 0.95; /* 增加透明度，使背景更加突出 */
}

/* 标题样式 */
.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #3a56a7;  /* 深蓝色 */
  margin-bottom: 40rpx;
  text-align: center;
}

/* 输入框的样式 */
.input-field {
  width: 100%;
  padding: 14rpx;
  margin: 12rpx -12rpx;
  border: 1rpx solid #d0d0d0;
  border-radius: 10rpx;
  font-size: 25rpx;
  background-color: #f5f7fb; /* 淡蓝色背景 */
  color: #333;
}

/* 记住用户信息复选框 */
.remember-container {
  margin: 15rpx 0;
  display: flex;
  align-items: center;
  font-size: 16rpx;
}

.remember-checkbox {
  margin-left: 350rpx;
}

/* 登录按钮的样式 */
.login-btn {
  width: 100%;
  padding: 14rpx;
  background-color: #1e62b6; /* 蓝色按钮 */
  color: #fff;
  border: none;
  border-radius: 30rpx;
  font-size: 18rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.2);
  transition: background-color 0.3s ease;
}

.login-btn:hover {
  background-color: #0f47a4; /* 悬停时按钮的深蓝色 */
}
