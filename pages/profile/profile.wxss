.profile-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
}

.profile-header {
  background-color: #ffffff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.user-info {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.avatar-placeholder {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background-color: #1989fa;
  display: flex;
  justify-content: center;
  align-items: center;
  margin-right: 30rpx;
}

.avatar-placeholder text {
  color: white;
  font-size: 48rpx;
  font-weight: bold;
}

.user-details {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.username {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.phone {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 6rpx;
}

.role {
  font-size: 24rpx;
  color: #999;
}
/* Transaction Module Styles */
.transaction-module {
  background-color: #ffffff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.module-title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 30rpx;
}

.transaction-grid {
  display: flex;
  justify-content: space-around;
}

.grid-item {
  text-align: center;
}

.item-count {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.item-label {
  font-size: 28rpx;
  color: #666;
}

.menu-list {
  background-color: #ffffff;
  margin-bottom: 30rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-text {
  font-size: 30rpx;
  color: #333;
}

.arrow {
  color: #999;
  font-size: 30rpx;
}

.logout-button {
  margin: 40rpx 30rpx;
  background-color: #ff4d4f;
  color: #ffffff;
  text-align: center;
  padding: 24rpx 0;
  border-radius: 8rpx;
  font-size: 32rpx;
} 